# Andiora API endpoint (no trailing slash)
ANDIORA_API_URL=https://bij7hee319.execute-api.us-east-1.amazonaws.com

# Optional short-lived developer access token. If empty, the MCP opens the
# Cognito browser login and exchanges the identity for an Andiora token.
ANDIORA_ACCESS_TOKEN=

# Optional fixed tenant context for local development. Production must derive this from claims.
ANDIORA_ORGANIZATION_ID=

# MCP-only Cognito OIDC configuration (no Cognito client secret is used).
MCP_OIDC_ISSUER=https://cognito-idp.us-east-1.amazonaws.com/<user-pool-id>
MCP_OIDC_CLIENT_ID=<public-app-client-id>
MCP_OIDC_SCOPES=openid email profile
MCP_OIDC_CALLBACK_PORT=4318

# Structured logger level: fatal,error,warn,info,debug,trace
LOG_LEVEL=info
