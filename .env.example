# Optional overrides. The published MCP already includes the dev API and
# Cognito configuration; most users should leave this file unused.
ANDIORA_API_URL=

# Optional short-lived developer access token. If empty, the MCP opens the
# Cognito browser login and exchanges the identity for an Andiora token.
ANDIORA_ACCESS_TOKEN=

# Optional fixed tenant context for local development. Production must derive this from claims.
ANDIORA_ORGANIZATION_ID=

# Advanced private-stage overrides (no Cognito client secret is used).
MCP_OIDC_ISSUER=
MCP_OIDC_CLIENT_ID=
MCP_OIDC_SCOPES=
MCP_OIDC_CALLBACK_PORT=

# Structured logger level: fatal,error,warn,info,debug,trace
LOG_LEVEL=info
