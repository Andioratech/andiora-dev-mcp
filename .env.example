# Andiora API endpoint (no trailing slash)
ANDIORA_API_URL=https://bij7hee319.execute-api.us-east-1.amazonaws.com

# Short-lived developer access token. Never commit the real value.
ANDIORA_ACCESS_TOKEN=

# Optional fixed tenant context for local development. Production must derive this from claims.
ANDIORA_ORGANIZATION_ID=

# Structured logger level: fatal,error,warn,info,debug,trace
LOG_LEVEL=info
